# Variables de entorno opcionales para AI Hub Web (AI_Hub_Aistudio)
PORT=3000
# Codigo maestro de administrador opcional (minimo 6 digitos o caracteres; si queda vacio se configura en el primer arranque)
AIHUB_ADMIN_CODE=
# Ruta de carpeta en disco del servidor (dejar comentada para usar la carpeta automatica del sistema)
# AIHUB_DATA_DIR=C:\Users\TuUsuario\AppData\Roaming\AIHub_Aistudio
# Nombre del tunel de Cloudflare usado por Iniciar_Tunel.bat (para aistudio.marinweb.org)
# AIHUB_TUNNEL=aistudio
# URL de Ollama local si usas modelos locales en el equipo servidor
# OLLAMA_URL=http://127.0.0.1:11434
# Sincronizacion automatica de GitHub -> carpeta local (robocopy en Windows / rsync en Linux/macOS)
# AIHUB_GITHUB_REPO=https://github.com/miguelmarin18630/AI_Hub_Aistudio.git
# AIHUB_GITHUB_BRANCH=main
# AIHUB_SYNC_TARGET_DIR=C:\Proyectos\AI_Hub_Aistudio
# AIHUB_AUTO_SYNC=1
# AIHUB_AUTO_SYNC_SECONDS=60
# Secreto HMAC-SHA256 opcional para webhook push de GitHub en POST /api/webhook/github
AIHUB_GITHUB_WEBHOOK_SECRET=

